# Copy to .env.local and fill in. Generate hashes with:
#   npm run hash-password -- "your-password"

# Main administrator (kosis). In production use the hash, not a plain password.
ADMIN_USERNAME=kosis
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-hash

# Optional fixed accounts (more can be created in Správa → Uživatelé).
ADMIN_JB_PASSWORD_HASH=
ADMIN_SARKA_PASSWORD_HASH=
ADMIN_PEPE_PASSWORD_HASH=
ADMIN_TKKOSKOVI_PASSWORD_HASH=

# Required in production. Long random string, e.g. `openssl rand -hex 32`.
# Changing it logs everybody out.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Required in production for /api/cron/refresh-trainings.
CRON_SECRET=replace-with-random-cron-secret

# SQLite database file. Keep it OUTSIDE the app folder so deploys never touch
# it, and back it up. Default when empty: data/koskovi.sqlite
DATABASE_PATH=/var/lib/koskovi-sal/koskovi.sqlite

# Optional public address, used for the QR code on /aplikace. Without it the
# address the visitor used is taken (works behind nginx with forwarded headers).
# APP_URL=https://sal.example.cz

# Only for a temporary test over plain http:// (without HTTPS the browser
# refuses the login cookie). Remove once HTTPS works.
# SESSION_COOKIE_SECURE=false
